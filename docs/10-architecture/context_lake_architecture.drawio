          <mxGeometry x="170" y="308" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="boxGates" value="Five gates&#xa;Write-time, build-time, model-output,&#xa;read-time, and Application B build.&#xa;A reject stops the bad fact." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="739" y="308" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="boxEnums" value="Closed lists&#xa;schemas/enums.generated.json&#xa;Sites, columns, and item ids.&#xa;check_claim looks names up here." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1308" y="308" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="boxBuild" value="build.py&#xa;Checks schemas, source hashes, the seven kinds, BP1 to BP8, the 25 cards, the six site maps, and every link target. Then it writes the SQLite file." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="170" y="492" width="780" height="72" as="geometry" />
        </mxCell>
        <mxCell id="boxSqlite" value="context-lake.sqlite3&#xa;items: 148 facts. edges: 180 links.&#xa;terms: 267 rows. items_fts: word search.&#xa;Runtime opens this file read-only." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="676" width="700" height="96" as="geometry" />
        </mxCell>
        <mxCell id="boxManifest" value="manifest.json&#xa;Build receipt.&#xa;Version 1.0.0, counts,&#xa;and the SQLite hash." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="900" y="676" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="boxPin" value="app-b-pin.json&#xa;Version, SQLite hash,&#xa;enum hash, and card ids.&#xa;Application B must match this hash." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
