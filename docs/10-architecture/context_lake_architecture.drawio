        <mxCell id="bandRead" value="5. Read path" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#E7F6E7;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="150" y="848" width="1680" height="132" as="geometry" />
        </mxCell>
        <mxCell id="bandReaders" value="6. Readers" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#F6EAF8;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="150" y="1036" width="1680" height="128" as="geometry" />
        </mxCell>
        <mxCell id="boxHarvest" value="Harvest scripts&#xa;context-lake/harvest/&#xa;Writes the YAML from the estate.&#xa;Lot rows stay in the operational databases." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="84" width="248" height="108" as="geometry" />
        </mxCell>
        <mxCell id="boxItems" value="YAML facts&#xa;context-lake/items/&#xa;148 facts. Seven kinds.&#xa;One fact per file." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="448" y="84" width="248" height="108" as="geometry" />
        </mxCell>
        <mxCell id="boxSemantic" value="Semantic layer&#xa;context-lake/semantic-layer/&#xa;Words and local names.&#xa;267 term rows after the build." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="726" y="84" width="248" height="108" as="geometry" />
        </mxCell>
        <mxCell id="boxEval" value="Eval files&#xa;context-lake/eval/&#xa;26 golden questions.&#xa;Injection corpus." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1004" y="84" width="248" height="108" as="geometry" />
        </mxCell>
        <mxCell id="boxReview" value="Review notes&#xa;context-lake/review/&#xa;Version 1.0.0.&#xa;Fixes from one review round." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1282" y="84" width="248" height="108" as="geometry" />
        </mxCell>
        <mxCell id="boxCards" value="Rule cards&#xa;items/rules/*.card.yaml&#xa;25 decision tables.&#xa;Checked at build. Stay as YAML." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1560" y="84" width="248" height="108" as="geometry" />
        </mxCell>
        <mxCell id="boxSchemas" value="JSON schemas&#xa;context-lake/schemas/&#xa;Item, link, rule card, and term shapes.&#xa;read-envelope.schema.json is the packet shape." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="308" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="boxGates" value="Five gates&#xa;Write-time and build-time keep a bad file out.&#xa;A claim check rejects the claim. The fact stays.&#xa;Application B stops when the SQLite hash differs." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="739" y="308" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="boxEnums" value="Closed lists&#xa;schemas/enums.generated.json&#xa;Sites, columns, and item ids.&#xa;check_claim looks names up here." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1308" y="308" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="boxBuild" value="build.py&#xa;Checks schemas, source hashes, the seven kinds, BP1 to BP8, the 25 cards, the six site maps, and every link target. Then it writes the SQLite file." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="170" y="492" width="780" height="72" as="geometry" />
        </mxCell>
        <mxCell id="boxSqlite" value="context-lake.sqlite3&#xa;148 facts, including draft data.draft.business_context.&#xa;180 links. 267 term rows. items_fts searches words.&#xa;A normal read leaves the draft out. Runtime opens this file read-only." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="676" width="700" height="96" as="geometry" />
        </mxCell>
        <mxCell id="boxManifest" value="manifest.json&#xa;Build receipt.&#xa;Version 1.0.0, counts,&#xa;and the SQLite hash." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="900" y="676" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="boxPin" value="app-b-pin.json&#xa;Version, SQLite hash, enum hash, and card ids.&#xa;Application B compares the SQLite hash.&#xa;The enum hash is recorded. The check does not compare it." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1330" y="676" width="478" height="96" as="geometry" />
        </mxCell>
        <mxCell id="boxRuntime" value="lake_runtime.py&#xa;Opens the file read-only.&#xa;search_items, get_item,&#xa;get_links, rule_at." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="884" width="460" height="76" as="geometry" />
        </mxCell>
        <mxCell id="boxRest" value="Lake REST&#xa;rest_server.py&#xa;Port 8091. Calls lake_runtime.&#xa;The pages do not call this port." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="680" y="884" width="460" height="76" as="geometry" />
        </mxCell>
        <mxCell id="boxMcp" value="Lake MCP&#xa;mcp_server.py&#xa;Port 8092. Same four tools. Calls lake_runtime.&#xa;The pages do not call this port." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1220" y="884" width="588" height="76" as="geometry" />
        </mxCell>
        <mxCell id="boxAppA" value="Application A&#xa;retrieve.py, agent/tools.py, and ground.py&#xa;Cites lake items. Pass or fail stays in its own code.&#xa;All three call lake_runtime.py in this process." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="1072" width="780" height="76" as="geometry" />
        </mxCell>
        <mxCell id="boxAppB" value="Application B&#xa;apps/app_b/rules/resolver.py&#xa;Rules come from the lake. Checks the pin. Reads the rule cards.&#xa;Calls lake_runtime.py in this process." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="990" y="1072" width="818" height="76" as="geometry" />
        </mxCell>
        <mxCell id="caption" value="The harvest writes the YAML files. build.py reads those files and writes the SQLite file, the name list, the receipt, and the pin.&#xa;lake_runtime.py serves both applications and both listeners." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
